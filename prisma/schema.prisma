datasource db {
  provider  = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario         String    @unique @db.VarChar(50)
  contrasena_hash String    @db.VarChar(255)
  nombre          String    @db.VarChar(150)
  rol             String    @db.VarChar(20) // 'admin' | 'vendedor'
  activo          Boolean?  @default(true)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  vendedor        Vendedor?

  @@map("usuarios")
}

model Cliente {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre           String          @db.VarChar(150)
  telefono         String          @db.VarChar(20)
  direccion        String
  ubicacion_url    String?
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?       @default(now()) @db.Timestamptz(6)
  pedidos          Pedido[]
  precios_clientes PrecioCliente[]

  @@map("clientes")
}

model Producto {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre           String          @unique @db.VarChar(100)
  precio_base      Decimal         @db.Decimal(10, 2)
  stock            Int             @default(0)
  unidad           String          @db.VarChar(20)
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?       @default(now()) @db.Timestamptz(6)
  precios_clientes PrecioCliente[]
  detalle_pedidos  DetallePedido[]

  @@map("productos")
}

model Vendedor {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id      String?        @unique @db.Uuid
  nombre          String         @db.VarChar(150)
  telefono        String?        @db.VarChar(20)
  avatar          String         @db.VarChar(10)
  activo          Boolean?       @default(true)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?      @default(now()) @db.Timestamptz(6)
  usuario         Usuario?       @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  pedidos         Pedido[]
  cierres_diarios CierreDiario[]

  @@map("vendedores")
}

model PrecioCliente {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  cliente_id      String    @db.Uuid
  producto_id     String    @db.Uuid
  precio_especial Decimal   @db.Decimal(10, 2)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  cliente         Cliente   @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  producto        Producto  @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([cliente_id, producto_id], map: "uq_cliente_producto")
  @@map("precios_clientes")
}

model Pedido {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  codigo         String          @unique @db.VarChar(20)
  cliente_id     String          @db.Uuid
  vendedor_id    String?         @db.Uuid
  estado         String          @default("pending") @db.VarChar(20) // 'pending' | 'loaded' | 'route' | 'delivered' | 'failed'
  total          Decimal         @default(0.00) @db.Decimal(10, 2)
  motivo_falla   String?
  fecha_creacion DateTime?       @default(now()) @db.Timestamptz(6)
  fecha_entrega  DateTime?       @db.Timestamptz(6)
  updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
  cliente        Cliente         @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  vendedor       Vendedor?       @relation(fields: [vendedor_id], references: [id], onDelete: SetNull)
  detalles       DetallePedido[]

  @@map("pedidos")
}

model DetallePedido {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  pedido_id       String   @db.Uuid
  producto_id     String   @db.Uuid
  cantidad        Int
  precio_aplicado Decimal  @db.Decimal(10, 2)
  pedido          Pedido   @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  producto        Producto @relation(fields: [producto_id], references: [id], onDelete: Restrict)

  @@unique([pedido_id, producto_id], map: "uq_pedido_producto")
  @@map("detalle_pedidos")
}

model CierreDiario {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  fecha            DateTime  @db.Date
  vendedor_id      String    @db.Uuid
  total_pedidos    Int
  entregados       Int
  fallidos         Int
  total_sistema    Decimal   @db.Decimal(10, 2)
  total_recaudado  Decimal   @db.Decimal(10, 2)
  diferencia       Decimal   @db.Decimal(10, 2)
  observaciones    String?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  vendedor         Vendedor  @relation(fields: [vendedor_id], references: [id], onDelete: Restrict)

  @@unique([fecha, vendedor_id], map: "uq_fecha_vendedor")
  @@map("cierres_diarios")
}
